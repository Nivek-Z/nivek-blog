---
import Base from "../../layouts/Base.astro";
import { posts, SITE_TITLE } from "../../lib/content";

function hkParts(iso: string) {
  const parts = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Asia/Hong_Kong",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).formatToParts(new Date(iso));
  const get = (type: string) => parts.find((part) => part.type === type)?.value || "";
  return { year: get("year"), month: get("month"), day: get("day") };
}

const chronological = [...posts]
  .filter((post) => post.publishTime)
  .sort((a, b) => Date.parse(b.publishTime || "") - Date.parse(a.publishTime || ""));

const months: { year: string; month: string; posts: typeof chronological }[] = [];
for (const post of chronological) {
  const date = hkParts(post.publishTime || "");
  const last = months[months.length - 1];
  if (!last || last.year !== date.year || last.month !== date.month) {
    months.push({ year: date.year, month: date.month, posts: [post] });
  } else {
    last.posts.push(post);
  }
}
const newestYear = months[0]?.year;
let monthIndexInYear = 0;
let seenYear = "";
const groups = months.map((group) => {
  if (group.year !== seenYear) {
    seenYear = group.year;
    monthIndexInYear = 0;
  } else {
    monthIndexInYear += 1;
  }
  return { ...group, indexInYear: monthIndexInYear, open: group.year === newestYear };
});
---
<Base title={`文章归档|${SITE_TITLE}`} template="page" contentClass="archives">
  <div slot="banner" class="page-header">
    <div class="pattern-title"><h1>文章归档</h1></div>
  </div>
  <article class="archives-article">
    <div id="archives-temp" class="archives-inner">
      <div class="archives-content">
        {groups.map((group) => (
          <div class:list={["archive-item", { active: group.open }]} id={`arti-${group.year}-${group.month}`}>
            <div class="archive-title">
              <span class="archive-time flex-child-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="m211.48 35.32l-130.25-23a20 20 0 0 0-23.18 16.22l-29.75 169a20 20 0 0 0 16.22 23.16l130.25 23a20 20 0 0 0 3.52.31A20 20 0 0 0 198 227.46l29.75-169a20 20 0 0 0-16.27-23.14M175 219.36L52.63 197.75L81 36.64l122.37 21.61ZM91.9 67a12 12 0 0 1 13.9-9.73L173 69.14A12 12 0 0 1 171 93a12.6 12.6 0 0 1-2.1-.18L101.63 80.9A12 12 0 0 1 91.9 67M85 106.39a12 12 0 0 1 13.91-9.73l67.22 11.88a12 12 0 0 1-2.13 23.81a12.5 12.5 0 0 1-2.1-.18l-67.21-11.88a12 12 0 0 1-9.69-13.9m-7 39.39a12 12 0 0 1 13.9-9.73l33.64 5.95a12 12 0 0 1-2.07 23.82a11.6 11.6 0 0 1-2.1-.19l-33.61-5.93A12 12 0 0 1 78 145.78"/></svg>
              </span>
              <h3>{group.year}-{group.month}</h3>
            </div>
            <div
              class={`archive-posts archives-${group.indexInYear}`}
              data-date={`${group.year}-${group.month}`}
              style="overflow: hidden"
            >
              {group.posts.map((post) => {
                const date = hkParts(post.publishTime || "");
                return (
                  <div class="archive-post-item">
                    <span class="archive-post-circle"></span>
                    <div class="arrow-left-ar"></div>
                    <div class="brick">
                      <a href={post.permalink} aria-label="get the next article">
                        <span class="time flex-child-center">
                          <svg class="iconify--large" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2M12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8s8 3.58 8 8s-3.58 8-8 8m-.22-13h-.06c-.4 0-.72.32-.72.72v4.72c0 .35.18.68.49.86l4.15 2.49c.34.2.78.1.98-.24a.71.71 0 0 0-.25-.99l-3.87-2.3V7.72c0-.4-.32-.72-.72-.72"/></svg>
                          {date.month}-{date.day}
                        </span>
                        {post.title}
                      </a>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </div>
  </article>
</Base>
