---
import type { TocNode } from "../lib/content";
import Toc from "./Toc.astro";
interface Props { nodes: TocNode[] }
const { nodes } = Astro.props;
---
{nodes.length > 0 && (
  <ol class="toc-list">
    {nodes.map((node) => (
      <li class="toc-list-item">
        <a class="toc-link" href={`#${node.id}`}>{node.text}</a>
        {node.children.length > 0 && <Toc nodes={node.children} />}
      </li>
    ))}
  </ol>
)}
